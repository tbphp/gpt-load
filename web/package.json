{
  "name": "gpt-load-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run type-check && vite build",
    "lint": "eslint . --max-warnings=0 && pnpm run check:styles",
    "check:styles": "node scripts/check-modern-styles.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/vue": "1.61.0",
    "@tanstack/vue-query": "5.104.5",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
